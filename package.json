{
  "name": "eco-grid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @ecogrid/api\" \"npm run dev -w @ecogrid/web\"",
    "db:seed": "npm run db:seed -w @ecogrid/api",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run check && npm run build -w @ecogrid/web"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.0.0",
    "typescript": "~5.9.0",
    "vitest": "^5.0.5"
  }
}
